# ─── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here

# ─── Vinted ────────────────────────────────────────────────────────────────────
# Intervalle (secondes) entre deux sondages du même filtre. Min recommandé : 60.
POLL_INTERVAL=90

# Nombre max d'articles récupérés par sondage
MAX_ITEMS_PER_POLL=20

# Nombre de jours avant de supprimer les IDs d'articles vus (nettoyage BDD)
SEEN_ITEMS_RETENTION_DAYS=7

# ─── Stockage ──────────────────────────────────────────────────────────────────
DATABASE_PATH=data/vinted.db
